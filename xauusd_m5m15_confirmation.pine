//@version=5
indicator("XAUUSD M5+M15 Confirmation Entry", overlay=true, max_labels_count=500)

// ============================================================
// XAUUSD Multi-Timeframe Entry Signal
// Bias      : M15 EMA50 vs EMA200
// Timing    : M5 pullback ke EMA20
// Konfirmasi: Engulfing atau Pin Bar searah bias
// Filter    : ATR minimum + jam sesi London/NY
// Output    : Panah entry, garis SL/TP, alertcondition untuk notif TV
// Pasang di chart M5. Bias diambil dari M15 via request.security.
// ============================================================

// ---------- Input ----------
grpBias   = "Bias (M15)"
emaFastLen = input.int(50,  "EMA Fast (M15)",  minval=5,  group=grpBias)
emaSlowLen = input.int(200, "EMA Slow (M15)",  minval=20, group=grpBias)

grpEntry  = "Entry (M5)"
emaPullLen = input.int(20,  "EMA Pullback (M5)", minval=5, group=grpEntry)
pullbackTolATR = input.float(0.5, "Toleransi pullback (x ATR)", minval=0.1, step=0.1, group=grpEntry,
     tooltip="Harga dianggap 'menyentuh' EMA pullback jika low/high berada dalam N*ATR dari EMA.")

grpConf   = "Candle Konfirmasi"
useEngulf = input.bool(true, "Pakai Bullish/Bearish Engulfing", group=grpConf)
usePin    = input.bool(true, "Pakai Pin Bar (wick >= 2x body)", group=grpConf)
pinRatio  = input.float(2.0, "Rasio wick/body minimum (pin bar)", minval=1.5, step=0.1, group=grpConf)

grpRisk   = "Risk / Reward"
atrLen    = input.int(14, "ATR Length", minval=5, group=grpRisk)
slBufATR  = input.float(0.3, "Buffer SL (x ATR)", minval=0.0, step=0.1, group=grpRisk)
rrRatio   = input.float(2.0, "Risk : Reward", minval=0.5, step=0.1, group=grpRisk)
minAtrPips = input.float(1.5, "ATR Minimum (USD)", minval=0.0, step=0.1, group=grpRisk,
     tooltip="Jika ATR M5 di bawah nilai ini, sinyal difilter (market terlalu sepi).")

grpSess   = "Filter Sesi (WIB / UTC+7)"
useSess   = input.bool(true, "Aktifkan filter sesi London + NY", group=grpSess)
sessSpec  = input.session("1300-2359", "Sesi aktif (waktu chart)", group=grpSess,
     tooltip="Default 13:00–23:59 WIB kira-kira menutup London + NY overlap. Sesuaikan dengan timezone chart Anda.")

// ---------- Data M15 (bias) ----------
[emaFast15, emaSlow15] = request.security(syminfo.tickerid, "15",
     [ta.ema(close, emaFastLen), ta.ema(close, emaSlowLen)],
     lookahead=barmerge.lookahead_off)

biasBull = emaFast15 > emaSlow15 and close > emaFast15
biasBear = emaFast15 < emaSlow15 and close < emaFast15

// ---------- Data M5 (entry) ----------
emaPull = ta.ema(close, emaPullLen)
atr     = ta.atr(atrLen)

// Pullback: bar sebelumnya (atau bar ini) menyentuh area EMA pullback
touchedFromAbove = low  <= emaPull + pullbackTolATR * atr and low  >= emaPull - pullbackTolATR * atr
touchedFromBelow = high >= emaPull - pullbackTolATR * atr and high <= emaPull + pullbackTolATR * atr

pulledBack = touchedFromAbove or touchedFromBelow or
   (low[1]  <= emaPull[1] + pullbackTolATR * atr[1] and low[1]  >= emaPull[1] - pullbackTolATR * atr[1]) or
   (high[1] >= emaPull[1] - pullbackTolATR * atr[1] and high[1] <= emaPull[1] + pullbackTolATR * atr[1])

// ---------- Candle konfirmasi ----------
bodyHi = math.max(open, close)
bodyLo = math.min(open, close)
body   = bodyHi - bodyLo
upperWick = high - bodyHi
lowerWick = bodyLo - low

bullEngulf = useEngulf and close > open and close[1] < open[1]
     and close >= open[1] and open <= close[1] and body > body[1]
bearEngulf = useEngulf and close < open and close[1] > open[1]
     and close <= open[1] and open >= close[1] and body > body[1]

bullPin = usePin and body > 0 and lowerWick >= pinRatio * body and upperWick <= body and close > open
bearPin = usePin and body > 0 and upperWick >= pinRatio * body and lowerWick <= body and close < open

bullConf = bullEngulf or bullPin
bearConf = bearEngulf or bearPin

// ---------- Filter tambahan ----------
atrOk   = atr >= minAtrPips
inSess  = not useSess or not na(time(timeframe.period, sessSpec))

// ---------- Sinyal akhir ----------
longSig  = biasBull and pulledBack and bullConf and atrOk and inSess and barstate.isconfirmed
shortSig = biasBear and pulledBack and bearConf and atrOk and inSess and barstate.isconfirmed

// ---------- Hitung SL / TP ----------
var float entryPrice = na
var float stopLoss   = na
var float takeProfit = na
var int   sigDir     = 0   // 1 = long, -1 = short

if longSig
    entryPrice := close
    stopLoss   := low  - slBufATR * atr
    takeProfit := entryPrice + rrRatio * (entryPrice - stopLoss)
    sigDir     := 1

if shortSig
    entryPrice := close
    stopLoss   := high + slBufATR * atr
    takeProfit := entryPrice - rrRatio * (stopLoss - entryPrice)
    sigDir     := -1

// ---------- Plot ----------
plot(emaPull,  "EMA Pullback M5", color=color.new(color.orange, 0), linewidth=1)
plot(emaFast15,"EMA50 M15",       color=color.new(color.aqua,   0), linewidth=2)
plot(emaSlow15,"EMA200 M15",      color=color.new(color.fuchsia,0), linewidth=2)

bgcolor(biasBull ? color.new(color.green, 92) : biasBear ? color.new(color.red, 92) : na, title="Bias BG")

plotshape(longSig,  title="LONG",  location=location.belowbar, style=shape.triangleup,
     color=color.new(color.lime, 0),  size=size.small, text="LONG")
plotshape(shortSig, title="SHORT", location=location.abovebar, style=shape.triangledown,
     color=color.new(color.red, 0),   size=size.small, text="SHORT")

// Garis SL/TP untuk sinyal terakhir
plot(sigDir != 0 ? entryPrice : na, "Entry", color=color.yellow,       style=plot.style_linebr, linewidth=1)
plot(sigDir != 0 ? stopLoss   : na, "SL",    color=color.red,          style=plot.style_linebr, linewidth=1)
plot(sigDir != 0 ? takeProfit : na, "TP",    color=color.new(color.lime,0), style=plot.style_linebr, linewidth=1)

if longSig or shortSig
    lbl = "Entry: "  + str.tostring(entryPrice, format.mintick) +
       "\nSL: "      + str.tostring(stopLoss,   format.mintick) +
       "\nTP: "      + str.tostring(takeProfit, format.mintick) +
       "\nRR: 1:"    + str.tostring(rrRatio,    "#.##")
    label.new(bar_index, longSig ? low : high, lbl,
         style = longSig ? label.style_label_up : label.style_label_down,
         color = longSig ? color.new(color.lime,20) : color.new(color.red,20),
         textcolor = color.white, size = size.small)

// ---------- Alert ----------
alertcondition(longSig,  title="XAUUSD LONG entry",
     message='{"symbol":"{{ticker}}","side":"LONG","tf":"{{interval}}","price":"{{close}}","time":"{{time}}"}')
alertcondition(shortSig, title="XAUUSD SHORT entry",
     message='{"symbol":"{{ticker}}","side":"SHORT","tf":"{{interval}}","price":"{{close}}","time":"{{time}}"}')
alertcondition(longSig or shortSig, title="XAUUSD ANY entry",
     message='XAUUSD {{ticker}} {{interval}} — sinyal entry pada {{close}}')
